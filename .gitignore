# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
venv/
.venv/
env/
*.pyc

# 環境変数・シークレット
.env
.env.*
!.env.example

# Google サービスアカウント JSON（絶対コミットしない）
*.json
!.devcontainer/*.json
# docs/data/ の JSON は GitHub Pages 用なのでコミット対象
!docs/data/*.json
# population/ の CSV はデータキャッシュ（コミット対象外）
population/*.csv

# Geocoding キャッシュ
geocache.json
geocache*.json

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# テスト・カバレッジ
.pytest_cache/
.coverage
htmlcov/

# フェーズ10 中間データ（大容量・再生成可能）
# 生データ（MLIT 等のダウンロード）。※geojson は地図の素材として保存するので対象外
analysis/geo_data/*.zip
analysis/geo_data/*.parquet
analysis/geo_data/*.osm.pbf
analysis/land_use_compact.csv
analysis/residential_ratio.csv
analysis/effective_distance.csv
analysis/score_v2.csv
analysis/score_v3.csv

# 調査用の使い捨てスクリプト・確認用の画像（先頭が「_」）
# ※残したいものは git add -f で追加する
analysis/_*.py
analysis/_*.png
population/_*.py

# PC だけの設定・ログ
*.log
logs/
board_folder.txt

# population/ の geojson はデータキャッシュ
population/*.geojson

analysis/geo_data/roads_*.json
analysis/geo_data/stations_*.json
screenshots/
